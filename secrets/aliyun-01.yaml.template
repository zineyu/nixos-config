# aliyun-01 的 secret 字段模板（未加密，可提交）。
#
# 该主机的 secret 文件已存在（secrets/aliyun-01.yaml，加密给 zine_desktop 与
# aliyun-01 两把 age key，见 .sops.yaml）。本文件只说明字段与新增 secret 的流程，
# 不要把它复制成 secrets/aliyun-01.yaml —— 那会用明文覆盖已加密的文件。
#
# 新增一个 secret：
# 1. 在下方追加字段，然后加密编辑真实文件：
#      sops secrets/aliyun-01.yaml
# 2. 在 hosts/aliyun-01/default.nix 里接线：
#      sops.secrets.<name> = {
#        sopsFile = ../../secrets/aliyun-01.yaml;
#        format = "yaml";
#        owner = "<service user>";
#        group = "<service group>";
#        mode = "0400";
#      };
# 3. 服务通过 config.sops.secrets.<name>.path 读该文件（现有的
#    luogo_checkin 就是这么接的）。
#
# 更换该主机的 age key（重装系统后 /etc/ssh 主机密钥会变）：
#   just age-key aliyun-01          # 取新的 ssh-to-age 公钥
#   更新 .sops.yaml 里的 &aliyun-01，然后
#   just sops-updatekeys            # 用新的收件人重新加密所有 secret
#
# 示例字段，按需替换为真实 secret。
example_secret: "replace-me-before-encrypting"
